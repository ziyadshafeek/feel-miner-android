<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feel Miner — Feelcoin only"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Official Feelcoin Miner v0.1.0, ported to Android ARM64. No Monero, no other coin. Pool: pool.feelcoin.org, TLS 4244 by default. Donate 0%. GPL-3.0, based on XMRig, Feelcoin Project."
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/guideText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Make a Feelcoin wallet yourself at wallet.feelcoin.org. This app does not make a wallet for you.\n2. Write the recovery seed on paper, offline. Never photograph it, never send it to anyone, never paste it here or in any chat.\n3. In your Feelcoin wallet tap Receive and copy only the public address.\n4. Paste only that public address below, choose a worker name, and tap Save.\n5. Plug the phone in, then tap Start mining. Mining pauses automatically when not charging, when CPU is 65 C or hotter, or when battery is 40 C or hotter.\n6. Watch for accepted shares. If no accepted shares appear, check the log below and the pool page for your worker." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FEEL public Receive address only — never a seed, private key, or password"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/walletEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste FEEL address here"
            android:inputType="textNoSuggestions" />

        <TextView
            android:id="@+id/walletError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF0000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Worker name"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/workerEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="phone"
            android:inputType="textNoSuggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Threads"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/threadsSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pool"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/poolSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/chargingOnlySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Charging only (recommended, ON by default)"
            android:checked="true"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save address"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start mining"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop mining"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: stopped"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/hashrateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hashrate: —" />

        <TextView
            android:id="@+id/sharesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accepted: 0  Rejected: 0" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log will appear here."
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
